# ---- Database (Neon Postgres) ----
# Create a free Neon project -> copy the pooled connection string.
# Without this the site runs in demo mode (orders are not persisted).
DATABASE_URL=

# ---- Moyasar (payments: mada / Visa / Mastercard / STC Pay / Apple Pay) ----
# Get keys from https://dashboard.moyasar.com -> Settings -> API Keys
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Set the same token in Moyasar Dashboard -> Webhooks (endpoint: /api/moyasar/webhook)
MOYASAR_WEBHOOK_SECRET=

# ---- Admin ----
# Open /admin?key=THIS_VALUE to view orders
ADMIN_KEY=change-me

# ---- Merchant identity (REQUIRED before launch) ----
# The Saudi E-Commerce Law requires the store to disclose who it is. These are
# rendered on /policies; any field left empty is simply hidden.
NEXT_PUBLIC_MERCHANT_NAME=
NEXT_PUBLIC_MERCHANT_CR=
NEXT_PUBLIC_MERCHANT_VAT=
NEXT_PUBLIC_MERCHANT_ADDRESS=
NEXT_PUBLIC_MERCHANT_EMAIL=
NEXT_PUBLIC_MERCHANT_PHONE=
# Your store's page on maroof.sa
NEXT_PUBLIC_MAROOF_URL=

# ---- Order notifications (optional, configure either or both) ----
# Telegram: message @BotFather -> /newbot -> copy the token. Then message your
# bot once and open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via Resend (resend.com). ORDER_EMAIL_FROM must be on a domain you verified there.
RESEND_API_KEY=
ORDER_EMAIL_TO=
ORDER_EMAIL_FROM=

# ---- Optional ----
# WhatsApp number for "order by WhatsApp", international format without +
NEXT_PUBLIC_WHATSAPP=9665XXXXXXXX
NEXT_PUBLIC_SITE_URL=https://qabda.store
